+def install_task_methods():
+    for task in TASKS:
+        for profile in ('light','full'):
+            def check(self,task=task,profile=profile):getattr(self,'run_'+profile)(task)
+            setattr(FormalTaskAcceptance,'test_'+profile+'_'+task,check)
+install_task_methods()
