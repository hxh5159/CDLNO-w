+def original(filename):
+    return subprocess.check_output(['git', 'show', '75e0f67643806a81cd1d3f6adc88dd8c02416fe7:'
+                                    + 'Car-Design-ShapeNetCar/' + filename], cwd=ROOT, text=True)
