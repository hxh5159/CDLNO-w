+                torch.testing.assert_close(t, t2, atol=0, rtol=0)
+                torch.testing.assert_close(y2, y.detach() + 1)
+
+    def test_front_down_zero_and_bridge_query_residual(self):
+        x = torch.randn(2, 35, 16)
