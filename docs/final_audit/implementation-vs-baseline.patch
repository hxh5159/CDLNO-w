+def config(*, L=8, F=2, mode='entry', structured=False):
+    return CDLNOArchitectureConfig(
+        L=L, F=F, M=4, d_model=8, num_heads=2, output_dim=3,
+        cdpa_mode=mode, structured=structured,
+        grid_shape=(5, 7) if structured else None,
+    )
+
