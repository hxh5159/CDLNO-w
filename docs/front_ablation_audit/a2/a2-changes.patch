+ROOT = Path(__file__).resolve().parents[1]
+MODES = ('full', 'no_sa', 'identity')
+STANDARD = ('darcy', 'elasticity', 'airfoil', 'pipe', 'ns', 'plasticity')
+TASKS = (*STANDARD, 'car', 'airfrans')
+SMALL = ['--n-hidden', '8', '--n-heads', '2', '--slice_num', '4']
