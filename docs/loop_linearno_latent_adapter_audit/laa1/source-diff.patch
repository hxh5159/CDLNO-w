+OPTIONS = {'architecture', 'cost_profile', 'topology_preset', 'executed_depth',
+           *TOPOLOGY_FIELDS, 'residual_mode', 'hidden_width', 'latent_width',
+           'actual_M', 'heads', 'latent_enabled', 'adapter_mode', 'adapter_rank', 'adapter_alpha'}
